# ===== WisdomLink2 backend config (copy to .env and edit) =====
# NOTE: keep this file ASCII/UTF-8. All values can also be set via real environment
#       variables (prefix WL2_). Component-level ACTIVE switches always win over
#       WL2_PROFILE; set ACTIVE=auto to follow WL2_PROFILE.

# --- App ---
WL2_ENV=dev
WL2_SECRET=change-me-to-a-random-string-at-least-32-chars
WL2_ADMIN_PW=admin123            # built-in admin password (NFR-219)
WL2_CORS_ORIGINS=http://localhost:5173

# Posture: local | remote | hybrid.
# Affects only components whose ACTIVE is "auto" (llm/emb/rerank).
WL2_PROFILE=hybrid

# --- Database / cache (uncomment for production; fallback: SQLite + in-memory) ---
# WL2_DB_URL=mysql+pymysql://wl2:wl2pass@localhost:3306/wl2?charset=utf8mb4
# WL2_REDIS_URL=redis://localhost:6379/0

# --- Object storage (default local dir; S3/MinIO optional) ---
WL2_OBJ_DRIVER=local             # local | s3
WL2_OBJ_LOCAL_DIR=./data/objects
WL2_S3_ENDPOINT=
WL2_S3_KEY=
WL2_S3_SECRET=
WL2_S3_BUCKET=wl2

# --- LLM (OpenAI-compatible protocol) ---
WL2_LLM_ACTIVE=remote            # remote | local | mock | auto
WL2_LLM_REMOTE_BASE_URL=https://api.openai.com/v1
WL2_LLM_REMOTE_API_KEY=
WL2_LLM_REMOTE_MODEL=gpt-4o-mini
WL2_LLM_LOCAL_BASE_URL=http://localhost:11434/v1   # Ollama / vLLM / Xinference
WL2_LLM_LOCAL_API_KEY=ollama
WL2_LLM_LOCAL_MODEL=qwen2.5:7b
WL2_LLM_VENDOR=                  # vendor label for remote LLM usage stats (empty=auto from URL; self-hosted: name it)
WL2_LLM_LOCAL_VENDOR=            # vendor label for local/self-hosted LLM (empty=auto; localhost -> local)

# --- Embedding ---
WL2_EMB_ACTIVE=mock              # remote | mock | auto
WL2_EMB_REMOTE_BASE_URL=
WL2_EMB_REMOTE_API_KEY=
WL2_EMB_REMOTE_MODEL=text-embedding-3-small
WL2_EMB_VENDOR=                  # vendor label for remote embedding (empty=auto)
WL2_EMB_LOCAL_VENDOR=            # vendor label for local embedding (mock mode -> mock)

# --- Rerank (optional; "none"/missing = skip rerank = degraded mode, NFR-222) ---
WL2_RERANK_ACTIVE=none           # none | local | api | cohere | auto
WL2_RERANK_LOCAL_PATH=           # e.g. ./models/bge-reranker-base (dir containing onnx/model.onnx or modelscope snapshot)
WL2_RERANK_LOCAL_DEVICE=         # cpu | cuda | ""(auto)
WL2_RERANK_LOCAL_VENDOR=         # vendor label for local rerank (empty=local)
WL2_RERANK_REMOTE_BASE_URL=      # api mode: Cohere-compatible /rerank endpoint (Cohere/Jina/SiliconFlow/vLLM/Xinference)
WL2_RERANK_REMOTE_MODEL=bge-reranker-v2-m3
WL2_RERANK_REMOTE_API_KEY=
WL2_RERANK_VENDOR=               # vendor label for api/cohere rerank (empty=auto; cohere defaults Cohere)

# --- Vector store (pluggable: qdrant | faiss) ---
WL2_VECTOR_DRIVER=qdrant
WL2_QDRANT_URL=http://localhost:6333
WL2_MILVUS_URI=http://localhost:19530     # Milvus standalone/cluster（WL2_VECTOR_DRIVER=milvus 时启用）
WL2_MILVUS_TOKEN=                          # 认证 token（可选）
WL2_MILVUS_DB=default
WL2_FAISS_DIR=./data/faiss

# --- QA fast-hit (BR-011) ---
WL2_QA_SIM_THRESHOLD=0.92
WL2_QA_MARGIN=0.02
WL2_QA_REVIEW_DAYS=90

# --- Token metering / pricing (BR-012): model=[in_price,out_price] per 1M tokens ---
WL2_PRICE_BOOK={"gpt-4o-mini":[1.0,4.0],"qwen2.5:7b":[0,0],"text-embedding-3-small":[0.3,0]}
WL2_CURRENCY=CNY
WL2_DAILY_TOKEN_LIMIT=20000000

# --- Preview conversion (optional: LibreOffice soffice path for Office->PDF) ---
WL2_SOFFICE_PATH=

# --- 日志 / 检索质量 / 启动 ---
WL2_LOG_LEVEL=INFO
WL2_LOG_DIR=./logs
WL2_RELEVANCE_FLOOR=0.2           # 重排后相关性下限（低于该值的引用不返回）
# WL2_RELOAD=1                    # 仅开发热重载时开启（默认关闭，避免子进程落到全局 Python）

# --- OCR（图片文字提取；本地 Tesseract 或远程视觉模型 API）---
WL2_OCR_ACTIVE=auto              # none | local | api | auto（local→api 逐级尝试）
WL2_OCR_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4    # OpenAI 兼容视觉模型端点
WL2_OCR_API_KEY=                 # 留空=继承 WL2_EMB_REMOTE_API_KEY 的值（需手动填）
WL2_OCR_API_MODEL=glm-4v-flash   # 智谱免费视觉模型（glm-4v-plus 效果更好）

# --- 联网检索（本地召回不足时的外部补充；灰度总开关：sys_config runtime_web_search=on）---
WL2_WEB_SEARCH_ACTIVE=none       # none | serper | bing | duckduckgo | mock
WL2_WEB_SEARCH_API_KEY=
WL2_WEB_SEARCH_BASE_URL=         # 自定义/自建搜索端点（兼容 serper/bing 协议时填）
WL2_WEB_SEARCH_TOP_N=5
WL2_WEB_SEARCH_TIMEOUT=5
