# S-08 安全基线：凭据与运行时数据绝不入库
backend/.env
backend/.env.local
backend/.env.*.local
*.pem
*.key

# 运行时数据 / 日志 / 模型
backend/data/
backend/logs/
backend/models/
backend/app/data/
backend/app/logs/
*.db
*.log
frontend/node_modules/
frontend/dist/

# Python
backend/.venv/
backend/__pycache__/
**/__pycache__/
.pytest_cache/
*.pyc

# IDE
.idea/
.vscode/

# 内部记忆库（不入库）
memory/
